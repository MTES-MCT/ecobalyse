#!/usr/bin/env node

/**
 * This script generates JSON Db fixtures so API server and Elm tests can rely
 * on consistent JSON data without having to rely on Http requests, which
 * is impossible in an Elm test environment.
 *
 * Usage: node bin/build-db <production|test>
 *
 * - `production` embeds `public/data/processes.json` into `src/Static/Json.elm`
 * - `test` embeds `public/data/processes_impacts.json` into `tests/Fixture/Json.elm`
 */
const fs = require("fs");
const path = require("path");

// Elm static db file template, used to build both prod and test dbs
const templateFile = "src/Static/Json.elm-template";

function parseAndValidate(relativePath, idKeyName = "id", pathsToMerge = []) {
  const filePath = path.join(dataDir, relativePath);
  let raw = JSON.parse(fs.readFileSync(filePath).toString());

  // Allow to pass multiple JSON files to this function, the arrays contained in the files
  // will be merge into one, as if they was only on file in input
  pathsToMerge.forEach((pathToMerge) => {
    const mergedPath = path.join(dataDir, pathToMerge);
    raw = raw.concat(JSON.parse(fs.readFileSync(mergedPath).toString()));
  });

  if (idKeyName && Array.isArray(raw)) {
    try {
      validatePrimaryKeys(raw, idKeyName);
    } catch (err) {
      console.error(`🚨 ERROR building ${filePath}:\n   ${err}`);
      process.exit(1);
    }
  }
  // Adapts a standard JSON string to what is expected to be the format
  // used in Elm's template strings (`"""{}"""`).
  return JSON.stringify(raw).replaceAll("\\", "\\\\");
}

function parseTarget(argv) {
  const targets = {
    production: {
      dataDir: "public/data",
      moduleName: "Static.Json",
      outFile: "src/Static/Json.elm",
      processesFileName: "processes.json",
    },
    test: {
      // TODO: add test data to a new dedicated directory
      dataDir: "public/data",
      moduleName: "Fixture.Json",
      outFile: "tests/Fixture/Json.elm",
      // TODO: eventually we should rely on fake detailed impacts in test data
      processesFileName: "processes_impacts.json",
    },
  };
  const [targetName, ...unexpectedArgs] = argv;
  if (unexpectedArgs.length > 0) {
    throw new Error(`Unexpected argument: ${unexpectedArgs.join(" ")}`);
  } else if (Object.hasOwn(targets, targetName)) {
    return targets[targetName];
  } else {
    throw new Error("Expected a single argument: production or test");
  }
}

/**
 * Validates that unique identifiers are actually unique in provided datasource.
 */
function validatePrimaryKeys(records, idKeyName) {
  const ids = records.map((record) => record[idKeyName]).sort();
  const duplicates = ids.filter((item, index) => ids.indexOf(item) !== index);
  if (duplicates.length > 0) {
    throw new Error(`Duplicate ${idKeyName}: ${duplicates}`);
  }
}

const { dataDir, moduleName, outFile, processesFileName } = parseTarget(process.argv.slice(2));
console.log(`Building the ${process.argv[2]} database…`);
const elmTemplate = fs.readFileSync(templateFile).toString();
const elmModuleContents = elmTemplate
  .replaceAll("%moduleName%", moduleName)
  // Transverse JSON data
  .replace("%componentConfigJson%", parseAndValidate("components/config.json", null))
  .replace("%countriesJson%", parseAndValidate("countries.json", "code"))
  .replace("%impactsJson%", parseAndValidate("impacts.json"))
  .replace("%processesJson%", parseAndValidate(processesFileName, "id"))
  .replace("%transportsJson%", parseAndValidate("transports.json"))
  // Food JSON data
  .replace("%foodIngredientsJson%", parseAndValidate("food/ingredients.json", "id"))
  .replace("%foodProductExamplesJson%", parseAndValidate("food/examples.json", "id"))
  // Food2 JSON data
  .replace("%food2ComponentsJson%", parseAndValidate("food2/components.json", "id"))
  .replace("%food2ProductCategoriesJson%", parseAndValidate("food2/categories.json", "id"))
  .replace("%food2ExamplesJson%", parseAndValidate("food2/examples.json", "id"))
  // Object JSON data
  .replace("%objectComponentsJson%", parseAndValidate("object/components.json", "id"))
  .replace("%objectProductCategoriesJson%", parseAndValidate("object/categories.json", "id"))
  .replace("%objectExamplesJson%", parseAndValidate("object/examples.json", "id"))
  // Textile JSON data
  .replace("%textileMaterialsJson%", parseAndValidate("textile/materials.json", "id"))
  .replace("%textileComponentsJson%", parseAndValidate("textile/components.json", "id"))
  .replace("%textileProductExamplesJson%", parseAndValidate("textile/examples.json", "id"))
  .replace("%textileProductsJson%", parseAndValidate("textile/products.json", "id"))
  // VeLi JSON data
  .replace("%veliComponentsJson%", parseAndValidate("veli/components.json", "id"))
  .replace("%veliProductCategoriesJson%", parseAndValidate("veli/categories.json", "id"))
  .replace("%veliExamplesJson%", parseAndValidate("veli/examples.json", "id"));

const header =
  "---- THIS FILE WAS GENERATED FROM THE FILE `Json.elm-template` BY THE `/bin/build-db` SCRIPT";

try {
  fs.mkdirSync(path.dirname(outFile), { recursive: true });
  fs.writeFileSync(outFile, `${header}\n\n${elmModuleContents}`);
  const fileSizeInKB = Math.ceil(fs.statSync(outFile).size / 1024);
  console.log(`Successfully generated Elm static database at ${outFile} (${fileSizeInKB} KB)`);
} catch (err) {
  throw new Error(`Unable to generate Elm static database: ${err}`);
}
