#!/usr/bin/env bash
# Actuellement une PR avec 200k LOC peut être un changement trivial de virgule
# dans un fichier crypté. L'indicateur LOC actuel est donc trompeur.
# L'objectif est de créer un meilleur indicateur de complexité d'une PR en
# ventilant le diff de la branche courante entre code, donnée source et
# fichiers générés (dont fichiers cryptés).
set -euo pipefail

base="${1:-origin/main}"

git diff --numstat "$base"...HEAD | awk -F'\t' '
    # premier motif qui matche gagne : les exceptions avant les génériques
    function bucket(p) {
        if (p ~ /^data\/food\/taxonomy_with_aliases\.json/) return "gen"
        if (p ~ /^(data\/lci_catalog|data\/food|schemas|data\/tests\/fixtures)\//) return "src"
        if (p ~ /^public\/data\/food2\/categories\.json/ || p ~ /^data\/(custom_lci|impacts)\.json/) return "src"
        if (p ~ /^(public\/data|data\/export|data\/tests\/snapshots)\//) return "gen"
        if (p ~ /^src\/Static\/Json\.elm/ || p ~ /package-lock\.json/) return "gen"
        if (p ~ /\.(py|elm|js|mjs|ts|sh)$/) return "code"
        return "other"
    }
    {
        b = bucket($3)
        n[b]++
        if ($1 == "-") bin[b]++
        else { add[b] += $1; del[b] += $2 }
    }
    END {
        label["code"] = "Code"; label["src"] = "Donnée source"
        label["gen"] = "Généré"; label["other"] = "Autre"
        print "| | fichiers | ajouts | suppressions |"
        print "|---|---|---|---|"
        split("code src gen other", order, " ")
        for (i = 1; i <= 4; i++) {
            b = order[i]
            if (n[b])
                printf "| %s | %d%s | +%d | -%d |\n", label[b], n[b], \
                    (bin[b] ? " (dont " bin[b] " binaire)" : ""), add[b], del[b]
        }
    }'
