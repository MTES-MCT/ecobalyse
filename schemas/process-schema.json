{
  "$id": "process-schema.json",
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "properties": {
    "activityName": {
      "type": "string"
    },
    "alias": {
      "type": ["string", "null"]
    },
    "categories": {
      "$ref": "lci-schema.json/#/properties/categories"
    },
    "comment": {
      "type": "string"
    },
    "displayName": {
      "$ref": "lci-schema.json/#/properties/displayName"
    },
    "elecKwh": {
      "minimum": 0,
      "type": "number"
    },
    "heatMJ": {
      "minimum": 0,
      "type": "number"
    },
    "id": {
      "$ref": "lci-schema.json/#/properties/id"
    },
    "impacts": {
      "properties": {
        "acd": {
          "type": "number"
        },
        "cch": {
          "type": "number"
        },
        "ecs": {
          "type": "number"
        },
        "etf": {
          "type": "number"
        },
        "etf-c": {
          "type": "number"
        },
        "fru": {
          "type": "number"
        },
        "fwe": {
          "type": "number"
        },
        "htc": {
          "type": "number"
        },
        "htc-c": {
          "type": "number"
        },
        "htn": {
          "type": "number"
        },
        "htn-c": {
          "type": "number"
        },
        "ior": {
          "type": "number"
        },
        "ldu": {
          "type": "number"
        },
        "mru": {
          "type": "number"
        },
        "ozd": {
          "type": "number"
        },
        "pco": {
          "type": "number"
        },
        "pma": {
          "type": "number"
        },
        "swe": {
          "type": "number"
        },
        "tre": {
          "type": "number"
        },
        "wtu": {
          "type": "number"
        }
      },
      "required": ["ecs"],
      "type": "object"
    },
    "massPerUnit": {
      "exclusiveMinimum": 0,
      "type": ["number", "null"]
    },
    "qtyVariationRatio": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "scopes": {
      "$ref": "lci-schema.json/#/properties/scopes"
    },
    "source": {
      "$ref": "lci-schema.json/#/properties/source"
    },
    "unit": {
      "enum": ["kg", "t⋅km", "kWh", "MJ", "L", "item", "m2", "m3"],
      "type": "string"
    }
  },
  "required": [
    "activityName",
    "categories",
    "comment",
    "elecKwh",
    "heatMJ",
    "id",
    "impacts",
    "massPerUnit",
    "qtyVariationRatio",
    "scopes",
    "source",
    "unit"
  ],
  "type": "object"
}
